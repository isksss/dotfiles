{
  "mcpServers": {
    "backlog": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "backlog-mcp-server"
      ],
      "env": {
        "BACKLOG_DOMAIN": "${BACKLOG_DOMAIN}",
        "BACKLOG_API_KEY": "${BACKLOG_API_KEY}"
      },
      "tools": [
        "*"
      ]
    },
    "excel": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@negokaz/excel-mcp-server"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
