{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "ollama/qwen2.5-coder:3b-opencode",
  "default_agent": "plan",
  "permission": "allow",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b-opencode": {
          "name": "Qwen2.5 Coder 7B (Ollama, 16K)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "qwen2.5-coder:3b-opencode": {
          "name": "Qwen2.5 Coder 3B (Ollama, 16K)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp"
    },
    "nuxtui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp"
    },
    "backlog": {
      "type": "local",
      "command": ["npx", "-y", "backlog-mcp-server"],
      "environment": {
        "BACKLOG_DOMAIN": "{env:BACKLOG_DOMAIN}",
        "BACKLOG_API_KEY": "{env:BACKLOG_API_KEY}"
      }
    }
  }
}
